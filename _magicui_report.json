  "animations": {
    "animate-marquee": "marquee var(--duration) infinite linear",
    "animate-marquee-vertical": "marquee-vertical var(--duration) linear infinite",
    "animate-blink-cursor": "blink-cursor 1.2s step-end infinite",
    "animate-shine": "shine var(--duration) infinite linear",
    "animate-shimmer-slide": "shimmer-slide var(--speed) ease-in-out infinite alternate",
    "animate-spin-around": "spin-around calc(var(--speed) * 2) infinite linear",
    "animate-orbit": "orbit calc(var(--duration)*1s) linear infinite",
    "animate-meteor": "meteor 5s linear infinite"
  },
  "keyframes_files": [],
  "custom_css": [
    {
      "name": "marquee",
      "css": "/* @keyframes marquee */\n{'from': {'transform': 'translateX(0)'}, 'to': {'transform': 'translateX(calc(-100% - var(--gap)))'}}\n\n/* @keyframes marquee-vertical */\n{'from': {'transform': 'translateY(0)'}, 'to': {'transform': 'translateY(calc(-100% - var(--gap)))'}}\n"
    },
    {
      "name": "typing-animation",
      "css": "/* @keyframes blink-cursor */\n{'0%, 49%': {'opacity': '1'}, '50%, 100%': {'opacity': '0'}}\n"
    },
    {
      "name": "shine-border",
      "css": "/* @keyframes shine */\n{'0%': {'background-position': '0% 0%'}, '50%': {'background-position': '100% 100%'}, 'to': {'background-position': '0% 0%'}}\n"
    },
    {
      "name": "shimmer-button",
      "css": "/* @keyframes shimmer-slide */\n{'to': {'transform': 'translate(calc(100cqw - 100%), 0)'}}\n\n/* @keyframes spin-around */\n{'0%': {'transform': 'translateZ(0) rotate(0)'}, '15%, 35%': {'transform': 'translateZ(0) rotate(90deg)'}, '65%, 85%': {'transform': 'translateZ(0) rotate(270deg)'}, '100%': {'transform': 'translateZ(0) rotate(360deg)'}}\n"
    },
    {
      "name": "orbiting-circles",
      "css": "/* @keyframes orbit */\n{'0%': {'transform': 'rotate(calc(var(--angle) * 1deg)) translateY(calc(var(--radius) * 1px)) rotate(calc(var(--angle) * -1deg))'}, '100%': {'transform': 'rotate(calc(var(--angle) * 1deg + 360deg)) translateY(calc(var(--radius) * 1px)) rotate(calc((var(--angle) * -1deg) - 360deg))'}}\n"
    },
    {
      "name": "meteors",
      "css": "/* @keyframes meteor */\n{'0%': {'transform': 'rotate(var(--angle)) translateX(0)', 'opacity': '1'}, '70%': {'opacity': '1'}, '100%': {'transform': 'rotate(var(--angle)) translateX(-500px)', 'opacity': '0'}}\n"
    }
  ]
}